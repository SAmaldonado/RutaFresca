# Base de datos (SQLite local por defecto; cambiar a PostgreSQL en producción)
DATABASE_URL="file:./dev.db"
# Ejemplo PostgreSQL:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/rutafresca?schema=public"

# Secreto para firma HMAC-SHA256 de sesiones HTTP-only
AUTH_SECRET="cambia-este-secreto-en-produccion"

# Habilita la barra de cambio rápido de rol demo (desactivar en producción con "false")
NEXT_PUBLIC_ENABLE_DEMO_SWITCHER="true"

# Adaptador de WhatsApp: "simulator" (Manual de Marca + wa.me) | "meta_cloud_api"
WHATSAPP_ADAPTER_MODE="simulator"
# WHATSAPP_CLOUD_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# Modo de fuentes externas (SIPSA / IDEAM / IPC): "seeded_colombia"
DATA_FEED_MODE="seeded_colombia"
